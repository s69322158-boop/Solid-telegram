@bot.message_handler(func=lambda m: m.text == '💰 Tap to Earn')
def tap(message):
    user_id = message.from_user.id
    current_time = time.time()

    if user_id in last_tap_timestamps:
        if current_time - last_tap_timestamps[user_id] < TAP_COOLDOWN_SECONDS:
            bot.send_message(user_id, "⚠️ *Slow down!* Please wait a second between taps.", parse_mode='Markdown')
            return

    last_tap_timestamps[user_id] = current_time

    user = get_user(user_id)
    if not user:
        bot.send_message(user_id, "Please press /start to begin.")
        return

    today_str = str(datetime.date.today())
    last_tap_date, daily_taps = user[3], user[4]
    vip = user[2]
    
    daily_limit = 50 if vip == 0 else (100 * vip)

    if last_tap_date != today_str:
        daily_taps = 0

    if daily_taps >= daily_limit:
        bot.send_message(user_id, f"⚠️ *Daily Limit Reached!*\nYou reached your limit of {daily_limit} taps today. Upgrade to VIP to tap more!", parse_mode='Markdown')
        return

    earn = 10 * VIP_MULTIPLIER.get(vip, 1)
    new_balance = user[1] + earn
    new_daily_taps = daily_taps + 1

    c.execute("UPDATE users SET balance=?, last_tap_date=?, daily_taps=? WHERE user_id=?", 
              (new_balance, today_str, new_daily_taps, user_id))
    conn.commit()

    remaining_taps = daily_limit - new_daily_taps
    bot.send_message(user_id, f"✅ +{earn} pts\n💰 Balance: {new_balance:,.0f} pts\n🎯 Taps remaining today: {remaining_taps}")

