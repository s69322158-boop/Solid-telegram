@bot.callback_query_handler(func=lambda call: call.data.startswith("view_task_"))
def handle_task_click(call):
    user_id = call.from_user.id
    task_id = int(call.data.split("_")[2])
    task = next((t for t in TASKS if t["id"] == task_id), None)

    if not task:
        return

    c.execute("SELECT * FROM completed_tasks WHERE user_id=? AND task_id=?", (user_id, task_id))
    if c.fetchone():
        bot.answer_callback_query(call.id, "You have already completed this task!", show_alert=True)
        return

    markup = types.InlineKeyboardMarkup()
    markup.add(types.InlineKeyboardButton("🔗 Open Task Link", url=task["link"]))
    markup.add(types.InlineKeyboardButton("✅ Claim Reward", callback_data=f"claim_task_{task_id}"))

    bot.send_message(
        user_id,
        f"📌 *{task['platform']} Task*\n\n1. Click 'Open Task Link' and watch/follow.\n2. Return here and click 'Claim Reward'.\n\n💰 Reward: *{task['reward']:,} points*",
        parse_mode='Markdown',
        reply_markup=markup
