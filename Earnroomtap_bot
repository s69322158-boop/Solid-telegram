@bot.message_handler(func=lambda m: m.text == '💸 Withdraw')
def withdraw(message):
    user_id = message.from_user.id
    user = get_user(user_id)
    
    if not user:
        bot.send_message(user_id, "Please press /start to begin.")
        return

    balance = user[1]
    vip = user[2]
    ref_count = user[7]

    min_required_pts = VIP_MIN_WITHDRAW.get(vip, 10000000)
    refs_required = VIP_REF_REQUIRED.get(vip, 3)

    if not can_withdraw():
        bot.send_message(
            user_id,
            f"""❌ *Withdrawals are currently CLOSED*

📅 Withdrawals open from the *25th to 30th* of every month.

Current Balance: {balance:,.0f} points
Keep tapping and watching videos! 💪""",
            parse_mode='Markdown'
        )
        return

    if ref_count < refs_required:
        bot.send_message(
            user_id,
            f"❌ *Referral Gate Locked!*\n\nFree users must invite at least *{refs_required} active friends* to unlock withdrawals.\nYour Referrals: *{ref_count}/{refs_required}*\n\n💡 *Tip:* Upgrade to VIP2 or higher to remove the referral requirement completely!",
            parse_mode='Markdown'
        )
        return

    if balance < min_required_pts:
        bot.send_message(
            user_id,
            f"❌ *Insufficient Balance*\n\nYour VIP level requires a minimum of *{min_required_pts:,.0f} points* to cash out.\nYour Balance: *{balance:,.0f} points*",
            parse_mode='Markdown'
        )
        return

    user_states[user_id] = 'awaiting_bank_details'
    bot.send_message(
        user_id,
        f"💸 *Withdrawal Request*\n\nPoints to withdraw: *{balance:,.0f}*\n\nPlease reply with your Bank Details in this format:\n\n`Bank Name, Account Number, Account Name`",
        parse_mode='Markdown'
    )

