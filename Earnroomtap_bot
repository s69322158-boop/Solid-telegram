@bot.message_handler(commands=['broadcast'])
def broadcast_message(message):
    if message.from_user.id != ADMIN_ID:
        return

    text_to_send = message.text.replace("/broadcast", "").strip()
    if not text_to_send:
        bot.send_message(ADMIN_ID, "Usage: `/broadcast Your message here`", parse_mode='Markdown')
        return

    c.execute("SELECT user_id FROM users")
    users = c.fetchall()
    
    successful, failed = 0, 0
    for u in users:
        try:
            bot.send_message(u[0], f"📢 *ANNOUNCEMENT*\n\n{text_to_send}", parse_mode='Markdown')
            successful += 1
        except Exception:
            failed += 1

    bot.send_message(ADMIN_ID, f"✅ Broadcast Complete!\n\nSent to: {successful} users\nFailed: {failed} users")

