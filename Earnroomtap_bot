@bot.callback_query_handler(func=lambda call: call.data.startswith(("approve_vip_", "reject_vip_")))
def process_vip_approval(call):
    if call.from_user.id != ADMIN_ID:
        return

    data = call.data.split("_")
    action = data[0]
    target_user_id = int(data[2])

    if action == "approve":
        vip_level = int(data[3])
        c.execute("UPDATE users SET vip_level=? WHERE user_id=?", (vip_level, target_user_id))
        conn.commit()

        bot.send_message(call.message.chat.id, f"✅ Approved VIP{vip_level} for User `{target_user_id}`", parse_mode='Markdown')
        try:
            bot.send_message(target_user_id, f"🎉 *Congratulations!* Your payment was verified and your account is upgraded to *VIP{vip_level}*!", parse_mode='Markdown')
        except Exception:
            pass

    elif action == "reject":
        bot.send_message(call.message.chat.id, f"❌ Rejected VIP upgrade for User `{target_user_id}`", parse_mode='Markdown')
        try:
            bot.send_message(target_user_id, "❌ Your VIP payment proof could not be verified. Please contact support.")
        except Exception:
            pass

