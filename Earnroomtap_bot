@bot.message_handler(content_types=['text', 'photo'], func=lambda m: m.from_user.id in user_states)
def handle_user_input(message):
    user_id = message.from_user.id
    state = user_states.get(user_id)

    if state == 'awaiting_vip_proof':
        del user_states[user_id]

        markup = types.InlineKeyboardMarkup()
        markup.add(
            types.InlineKeyboardButton("VIP 1", callback_data=f"approve_vip_{user_id}_1"),
            types.InlineKeyboardButton("VIP 2", callback_data=f"approve_vip_{user_id}_2"),
            types.InlineKeyboardButton("VIP 3", callback_data=f"approve_vip_{user_id}_3")
        )
        markup.add(
            types.InlineKeyboardButton("VIP 4", callback_data=f"approve_vip_{user_id}_4"),
            types.InlineKeyboardButton("VIP 5", callback_data=f"approve_vip_{user_id}_5")
        )
        markup.add(types.InlineKeyboardButton("❌ Reject", callback_data=f"reject_vip_{user_id}"))

        if message.content_type == 'photo':
            photo_id = message.photo[-1].file_id
            caption = message.caption if message.caption else "No details written."
            bot.send_photo(
                ADMIN_ID,
                photo_id,
                caption=f"🔔 *NEW VIP PAYMENT RECEIPT*\n\n*User ID:* `{user_id}`\n*Caption:* {caption}",
                parse_mode='Markdown',
                reply_markup=markup
            )
        else:
            bot.send_message(
                ADMIN_ID,
                f"🔔 *NEW VIP PAYMENT PROOF*\n\n*User ID:* `{user_id}`\n*Details:* {message.text}",
                parse_mode='Markdown',
                reply_markup=markup
            )

        bot.send_message(user_id, "✅ Your payment details have been sent to the admin. You will be upgraded shortly!")

    elif state == 'awaiting_bank_details':
        if message.content_type != 'text':
            bot.send_message(user_id, "Please supply text containing your bank details.")
            return

        del user_states[user_id]
        user = get_user(user_id)
        balance = user[1]

        bank_info = message.text
        c.execute("INSERT INTO withdrawals (user_id, points, bank_info, status) VALUES (?, ?, ?, 'Pending')",
                  (user_id, balance, bank_info))
        c.execute("UPDATE users SET balance=0 WHERE user_id=?", (user_id,))
        conn.commit()

        bot.send_message(
            ADMIN_ID,
            f"💸 *NEW WITHDRAWAL REQUEST*\n\n*User ID:* `{user_id}`\n*Points:* {balance:,.0f}\n*Bank Details:* {bank_info}",
            parse_mode='Markdown'
        )
        bot.send_message(user_id, "✅ *Withdrawal Request Submitted!*\nYour payout will be processed during the 25th–30th payout window.")

