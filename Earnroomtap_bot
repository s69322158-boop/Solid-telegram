def get_user(user_id):
    c.execute("SELECT * FROM users WHERE user_id=?", (user_id,))
    return c.fetchone()

def can_withdraw():
    today = datetime.datetime.now().day
    return PAYOUT_START_DAY <= today <= PAYOUT_END_DAY

